# ------------------------------------------------------------------
# Database (PostgreSQL)
# ------------------------------------------------------------------
# Local dev: postgresql://postgres:postgres@localhost:5432/mcserver
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/mcserver"

# ------------------------------------------------------------------
# Session (iron-session)
# ------------------------------------------------------------------
# Encrypts the login cookie AND signs the OAuth state parameter.
# If it leaks, anyone can forge a logged-in session.
#
# Generate with:
#   openssl rand -base64 32
# or on Windows PowerShell:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
#
# Requirements: at least 32 characters, and NOT the placeholder below.
# Development falls back to a built-in value when this is empty;
# PRODUCTION THROWS at request time instead of silently using a public
# default. `debug.bat build` / `start` refuse to run if it is weak.
# ------------------------------------------------------------------
SESSION_SECRET="replace-me-with-a-long-random-string"

# ------------------------------------------------------------------
# Microsoft / Xbox / Minecraft OAuth
# ------------------------------------------------------------------
# Register an application at https://portal.azure.com/#view/Microsoft_AAD_RegisteredApps/ApplicationsList
# - Supported account types: Personal Microsoft accounts only
# - Redirect URI: {SITE_URL}/api/auth/callback
# - API permissions: none required (only delegated sign-in + XboxLive.signin scope)
#
# IMPORTANT: registering the app is NOT sufficient. New applications must be
# manually added to Mojang's API allow list, otherwise the final
# /authentication/login_with_xbox call returns HTTP 403 "Invalid app
# registration". Submit the AppID review form first - see the
# "Minecraft API allow list approval" section in README.md / README.zh-CN.md.
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""
MICROSOFT_REDIRECT_URI="http://localhost:3000/api/auth/callback"

# Public URL of the site (used for redirects / cookies / SEO)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Shown in the "from" name and in verification emails
NEXT_PUBLIC_SITE_NAME="Minecraft Server"

# ------------------------------------------------------------------
# SMTP (email verification codes / password reset)
# ------------------------------------------------------------------
# ONE mailbox is enough. This is the SENDER, not the recipients.
# You configure your own mailbox once, and it can send verification
# codes to ANY address (gmail, 163, outlook, whatever the users have).
#
#   SMTP_USER / SMTP_PASS  = the mailbox that SENDS the mail  (1 account)
#   recipient address      = filled in per-request by the app, never configured
#
# Used to send 6-digit codes for: binding an email, changing it, and
# resetting a forgotten password.
#
# If these are left empty:
#   - development: the code is printed to the dev-server console and shown
#     on the page, so the whole flow still works locally
#   - production:  verification emails fail loudly instead of silently
#
# Examples (use an app password / 授权码, NOT your login password):
#   QQ Mail    host=smtp.qq.com        port=465  secure=true
#   NetEase    host=smtp.163.com       port=465  secure=true
#   Gmail      host=smtp.gmail.com     port=465  secure=true
#   Outlook    host=smtp.office365.com port=587  secure=false
#
# Check it with:  node scripts/dev.mjs mail:test you@example.com
#
# SMTP_HOST="smtp.qq.com"
# SMTP_PORT="465"
# SMTP_SECURE="true"
# SMTP_USER="your-own-mailbox@qq.com"   # <- the sender
# SMTP_PASS="your-app-password"
# SMTP_FROM="your-own-mailbox@qq.com"   # <- must match SMTP_USER

# ------------------------------------------------------------------
# Real player count on the homepage (Server List Ping)
# ------------------------------------------------------------------
# Read straight from the Minecraft server with the vanilla status protocol
# (src/server/mc-ping.ts). No plugin needed - Fabric implements it.
#
# DISABLED BY DEFAULT: nothing is probed unless MC_PING_HOST is set
# (or MC_PING=1). That is deliberate - a deployment whose MC server lives
# on another machine would otherwise wait for a doomed connection attempt
# on every cache expiry, and the homepage would wrongly show "offline".
#
#   MC_PING_HOST="127.0.0.1"   # turn it on (this is also the default host)
#   MC_PING_PORT="25565"
#   MC_PING="0"                # force off even when HOST is set
#   MC_PING_CACHE_MS="30000"   # how long a result is reused
#   MC_PING_TIMEOUT_MS="1500"  # connect + read budget
#
# Results are cached and de-duplicated, so the homepage never opens a
# socket per request. When it is off, the card falls back to the static
# values in src/config/site.ts.

# ------------------------------------------------------------------
# Client IP behind a reverse proxy
# ------------------------------------------------------------------
# The app takes the RIGHTMOST x-forwarded-for entry (the one your proxy
# appended) and only trusts it when it parses as an IP. Set
# TRUST_PROXY="0" when the app is exposed directly with no proxy in
# front - every request then counts as "unknown" and shares a single
# rate-limit bucket, which is the safe direction.
#
# Reminder: the proxy must APPEND the client address rather than pass the
# incoming header through. In nginx that is:
#   proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
# TRUST_PROXY="1"
#
# TRUST_CF_CONNECTING_IP="1"  -> prefer Cloudflare's cf-connecting-ip header,
# which the edge overwrites so clients cannot forge it.
#
# Turn this ON only when the origin has NO other inbound path:
#   - the site is exposed through a Cloudflare Tunnel (cloudflared dials
#     out; no port is published), or
#   - the origin firewall only accepts Cloudflare's IP ranges.
# Turn it OFF if the app port is reachable from the internet - then anyone
# can set cf-connecting-ip themselves and the per-IP quotas and the sign-in
# throttle become meaningless again.
# TRUST_CF_CONNECTING_IP="1"
