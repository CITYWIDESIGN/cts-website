# ===========================================================================
#  生产环境变量模板
#
#  用法：
#    cp .env.production.example .env       # 部署目录里叫 .env 就行
#    然后逐项填好，再 docker compose -f docker-compose.prod.yml up -d
#
#  ⚠️ **这个文件本身可以进仓库（全是占位符），你填好的 `.env` 绝对不能进**
#     —— `.gitignore` 里已经有 `.env*`，别改它。
# ===========================================================================

# ------------------------------------------------------------------ 数据库
# POSTGRES_PASSWORD 是容器建库时用的，之后改这里不会改已存在的库。
# 生成一个随机密码：
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
POSTGRES_USER="cts"
POSTGRES_PASSWORD=""
POSTGRES_DB="cts_website"

# ------------------------------------------------------------------ 会话
# 登录 cookie 的加密密钥，同时用来签 OAuth 的 state。
# **泄露 = 任何人都能伪造登录态。** 生产环境缺失会直接报错，不会用默认值。
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_SECRET=""

# ------------------------------------------------------------------ 站点
# 走 Cloudflare Tunnel，所以是 https 的 web 子域。
# ctserver.top 保持原样（MC 的 7 个端口都挂在它上面）。
NEXT_PUBLIC_SITE_URL="https://web.ctserver.top"
NEXT_PUBLIC_SITE_NAME="CTS 服务器"

# ------------------------------------------------------------------ 隧道
# Cloudflare Zero Trust → Networks → Tunnels → 新建 → 复制 token
# Public Hostname 必须是 web.ctserver.top → http://app:3000
# ⚠️ 填成 ctserver.top 会改掉 apex 的 A 记录，MC 全部掉线
TUNNEL_TOKEN=""

# ------------------------------------------------------------------ Microsoft 登录
# AppID 审批没过之前最后一步会 403，本地账号不受影响。
# ⚠️ 记得去 Azure 把回调地址**加上**（不是替换）：
#      https://web.ctserver.top/api/auth/callback
#    旧的那个 https://ctserver.top/api/auth/callback 可以留着。
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""
MICROSOFT_REDIRECT_URI="https://web.ctserver.top/api/auth/callback"

# ------------------------------------------------------------------ 邮件
# 和本地开发用同一个发件邮箱就行（它是发送方，不是收件人）。
# 留空的话：生产环境发验证码会直接报错，不会静默失败。
SMTP_HOST=""
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""

# ------------------------------------------------------ 真实在线人数（可选）
# 默认走 host.docker.internal，即宿主机上的 25565（velocity 代理），
# 拿到的是整个网络的在线人数。留空或设 MC_PING=0 就关掉，
# 首页回退到 src/config/site.ts 的静态值。
MC_PING_HOST="host.docker.internal"
MC_PING_PORT="25565"
